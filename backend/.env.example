# Copy this file to .env and fill in the real values. Never commit .env.

# Supabase transaction pooler (port 6543). Used by the running backend (src/db.ts).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Supabase session pooler (port 5432). Used only by the Prisma CLI (migrations).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Long random string used to sign login tokens.
# Generate one by running this in the terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Also add it in Vercel once login is built.
JWT_SECRET=""

# OpenAI API key for story generation. Only used by the local batch script.
OPENAI_API_KEY=""

# Secret that Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
# The /cron/publish endpoint refuses every request if this is not set.
# Generate one by running this in the terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Add the same value in Vercel under Settings → Environment Variables.
CRON_SECRET=""